# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# --- Client (shipped to the browser) ---------------------------------------
# Anything prefixed VITE_ is inlined into the bundle at build time and is
# PUBLIC. Only put non-secret values here. (SPEC §9.3)
# Convex deployment URL — safe to expose. Filled in by `npx convex dev`.
VITE_CONVEX_URL=

# --- Server / scripts only (never prefixed VITE_) --------------------------
# The owner's provider key used by the seed script (SPEC §10). NEVER prefix
# this VITE_ — that would ship the owner's key to every visitor.
OWNER_OPENAI_API_KEY=
OWNER_GEMINI_API_KEY=
